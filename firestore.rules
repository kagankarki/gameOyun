rules_version = '2';

// Firebase Console > Firestore Database > Kurallar sekmesine bu içeriği yapıştır.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isTeacher() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    // Kullanıcı profilleri: herkes okuyabilir, sadece sahibi yazabilir.
    //
    // Rol kayıttan SONRA değiştirilemez — aksi hâlde öğrenci olarak kayıt
    // olup kendi dokümanını `role: 'teacher'` diye güncelleyen biri bütün
    // hoca yetkilerini ele geçirirdi. (Kayıt anında rol seçimi hâlâ
    // istemci tarafındaki hoca koduna güveniyor; bkz. README.)
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && request.auth.uid == userId
        && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    // Dersler: giriş yapan herkes okur, sadece öğretim üyesi yazar.
    match /lessons/{lessonId} {
      allow read: if signedIn();
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if isTeacher()
        && resource.data.teacherId == request.auth.uid;
    }

    /* ════════════════════════════════════════════════════════
       AMFİ / CANLI DERS
       Öğrenciler hesap açmadan katılır; uygulama onları ANONİM
       oturumla imzalar. Bu yüzden signedIn() burada anonim
       kullanıcıyı da kapsar.

       KURULUM: Firebase Console > Authentication > Sign-in method
       bölümünden "Anonymous" sağlayıcısını ETKİNLEŞTİR, yoksa
       öğrenciler katılamaz.
       ════════════════════════════════════════════════════════ */

    // Oturum: katılacaklar okur, yalnızca oturumu açan hoca yazar.
    match /sessions/{sessionId} {
      allow read: if signedIn();
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if isTeacher() && resource.data.teacherId == request.auth.uid;
    }

    // Katılımcılar: herkes okur (canlı sıralama).
    // Öğrenci kendini ekler; puanı yalnızca hoca günceller —
    // öğrencinin kendi puanını yazabilmesi hile kapısı olurdu.
    match /participants/{participantId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if isTeacher();
      allow delete: if isTeacher();
    }

    // Ziller: öğrenci basar, silinemez/değiştirilemez.
    // Hoca puanlama için okur.
    match /buzzes/{buzzId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if false;
    }

    // Ders metni, hataların yeri ve soruların DOĞRU ŞIKLARI.
    // Yalnızca oturumu açan hoca okuyabilir — öğrenci okuyabilseydi
    // bütün cevapları ders başlamadan görürdü.
    match /sessionSecrets/{sessionId} {
      allow read: if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if isTeacher() && resource.data.teacherId == request.auth.uid;
    }

    // Yakalamalar: öğrenci yalnızca "bastım" der; hangi hata, kaç puan
    // ve hangi soru olduğunu hoca cihazı yazar.
    //
    // Öğrencinin yazabildiği tek şey `answerIndex` — şık seçimi. Puanı
    // kendi yazabilseydi istediği kadar veirdi.
    match /catches/{catchId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.status == 'pending'
        && request.resource.data.points == 0;
      allow update: if isTeacher()
        || (signedIn()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['answerIndex']));
      allow delete: if isTeacher();
    }

    // Araştırma anketi: öğrenci doldurur, hoca okur.
    match /surveys/{surveyId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isTeacher();
    }

    // Ders sonu değerlendirmesi (5 yıldız): her katılımcı bir oy.
    // Doküman kimliği katılımcıdan türetildiği için ikinci gönderim
    // kendi oyunu günceller, başkasınınkini değil.
    match /ratings/{ratingId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.stars is number
        && request.resource.data.stars >= 1
        && request.resource.data.stars <= 5
        && ratingId == 'rate_' + request.resource.data.participantId;
      allow delete: if isTeacher();
    }
  }
}
