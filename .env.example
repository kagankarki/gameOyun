# ─────────────────────────────────────────────────────────────
#  FIREBASE AYARLARI
#  Bu dosyayı ".env" olarak kopyala ve kendi Firebase bilgilerini gir.
#  (Firebase Console > Proje Ayarları > Genel > Web uygulaması)
#
#  BU DOSYA OLMASA DA SİTE ÇALIŞIR!
#  .env yoksa uygulama otomatik olarak "DEMO MOD"a düşer ve
#  verileri tarayıcının localStorage'ında tutar. Böylece
#  Firebase kurmadan da her şeyi test edebilirsin.
# ─────────────────────────────────────────────────────────────

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Hoca hesabı olarak kayıt olurken istenen gizli kod
VITE_TEACHER_CODE=gazi2026

# Gemini API — Amfi 2.0'da öğrenci notlarının doğrulanması için
# https://ai.google.dev/pricing adresinde ücretsiz bir anahtar al (en fazla 15 istek/dakika)
# Bu olmasa da site çalışır, Gemini doğrulaması sadece kapalı kalır.
VITE_GEMINI_API_KEY=
